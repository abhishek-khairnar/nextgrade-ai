# NextGrade AI - Backend Environment Configuration Template
# Copy this file to .env for local overrides

API_HOST=127.0.0.1
API_PORT=8000
NEXTGRADE_ENV=development

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database URL (SQLite)
DATABASE_URL=sqlite:///./nextgrade.db
